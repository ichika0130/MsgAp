{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO messages (content, location)\n        VALUES (\n            $1,\n            ST_SetSRID(ST_MakePoint($2, $3), 4326)\n        )\n        RETURNING\n            id,\n            content,\n            ST_X(location) AS \"longitude!: f64\",\n            ST_Y(location) AS \"latitude!: f64\",\n            likes,\n            created_at\n        ",
